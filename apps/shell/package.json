{
  "name": "ai-materials-integrated-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Integrated material property prediction and simulation dashboard.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron": "^34.5.8"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.maps.platform",
    "productName": "MAPS",
    "copyright": "Copyright © 2025 MAPS Team",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build_resources"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist_python/main_app",
        "to": "main_app",
        "filter": ["**/*"]
      },
      {
        "from": "../simulation/dist",
        "to": "simulation/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../simulation/electron",
        "to": "simulation/electron",
        "filter": ["preload.cjs", "shared.cjs"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MAPS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
