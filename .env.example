# MAPS monorepo env (copy to .env and adjust)
AI_MATERIALS_PLATFORM_DIR=apps/prediction
AI_MATERIALS_SIMULATION_DIR=apps/simulation
AI_MATERIALS_PYTHON=python
# Prediction Flask API (apps/prediction/src/api/server.py)
PREDICTION_API_PORT=5000
# Simulation backend (apps/simulation/backend/simulation_server.py)
SIMULATION_API_PORT=8765
# Simulation frontend (Vite)
VITE_PORT=5173
# Chatbot — 팀 게이트웨이(apps/gateway)를 거쳐 Qwen 사용. OpenAI 키는 넣지 않는다.
# LLM_BASE_URL: 게이트웨이 주소 + /v1 (예: https://<서비스>.onrender.com/v1)
LLM_BASE_URL=
# LLM_API_KEY: 관리자가 발급한 접속 코드 (apps/gateway/tools/new_code.py)
LLM_API_KEY=
# LLM_MODEL: 게이트웨이가 정하므로 비워 둔다
LLM_MODEL=
LLM_TIMEOUT=120
# 이미지 입력을 못 받는 모델이면 0 (그래프 이미지를 빼고 보냄)
LLM_VISION=1
